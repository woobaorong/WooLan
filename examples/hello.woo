package examples
import TimeCallbacker
// hello.woo - basic variables, types, strict typing, conversions
sys.println("Hello, Woolan!")

int a = 10
int b = 20
int c = a + b
sys.println("a + b = " + sys.int2str(c))

float f = 3.14
sys.println("f = " + sys.float2str(f))

bool ok = true
sys.println("ok = " + sys.bool2str(ok))

char ch = 'W'
// char does not support '+' (strict typing); convert explicitly to String
sys.println("char = " + String(ch))
sys.println(ch)





class Callbacker extends TimeCallbacker {
    void onTime() {
        sys.println("callbacker::onTime")
    }
}

sys.wait(Callbacker(), 1000)

String str = "Hello, Woolan!"
sys.println(str)