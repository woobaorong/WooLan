// file.woo - File built-in class (read / write / append / exists)
File f = File("test_output.txt")
f.write("first line\n")
f.append("second line\n")
sys.println(f.read())
sys.println("exists = " + sys.bool2str(f.exists()))
sys.println("size = " + sys.int2str(f.size()))
f.delete()
sys.println("exists after delete = " + sys.bool2str(f.exists()))
