// recursion.woo - recursive methods
class Math {
    int fib(int n) {
        if (n < 2) {
            return n
        }
        return this.fib(n - 1) + this.fib(n - 2)
    }

    int fact(int n) {
        if (n <= 1) {
            return 1
        }
        return n * this.fact(n - 1)
    }
}

Math m = Math()
for (int i = 0; i < 10; i = i + 1) {
    sys.println("fib(" + sys.int2str(i) + ") = " + sys.int2str(m.fib(i)))
}
sys.println("fact(10) = " + sys.int2str(m.fact(10)))
