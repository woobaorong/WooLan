// containers.woo - List, Map, Set built-in classes

List nums = List()
nums.add(10)
nums.add(20)
nums.add(30)
sys.println("size = " + sys.int2str(nums.size()))
sys.println("nums[1] = " + sys.int2str(nums.get(1)))
nums.set(0, 99)
sys.println("nums[0] = " + sys.int2str(nums.get(0)))

Map m = Map()
m.put("one", 1)
m.put("two", 2)
m.put("three", 3)
sys.println("m[one] = " + sys.int2str(m.get("one")))
sys.println("has two = " + sys.bool2str(m.containsKey("two")))
sys.println("map size = " + sys.int2str(m.size()))

Set s = Set()
s.add(1)
s.add(1)
s.add(2)
s.add(3)
sys.println("set size = " + sys.int2str(s.size()))
sys.println("has 2 = " + sys.bool2str(s.contains(2)))
