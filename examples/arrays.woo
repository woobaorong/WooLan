// arrays.woo - typed arrays
int[] arr = [1, 2, 3]
sys.println(arr[0])
sys.println(arr[2])
arr[1] = 42
sys.println(arr[1])

char[] chs = ['a', 'b', 'c']
sys.println(chs[0])
sys.println(chs[2])

// allocate with size
int[] nums = int[5]
nums[0] = 10
sys.println(nums[0])

// iterate with for
int sum = 0
for (int i = 0; i < 3; i = i + 1) {
    sum = sum + arr[i]
}
sys.println("sum = " + sys.int2str(sum))
